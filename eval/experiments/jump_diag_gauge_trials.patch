+void KeypointVioEstimator::projectGauge(const AbsOrderMap& order, Eigen::MatrixXd& H,
+                                        Eigen::VectorXd& b) const {
+  // N: common translation of all poses and states (3 columns). P = I - N N^T / n.
+  const int size = order.total_size;
+  Eigen::MatrixXd N = Eigen::MatrixXd::Zero(size, 3);
+  for (const auto& kv : order.abs_order_map) N.block<3, 3>(kv.second.first, 0).setIdentity();
+  const double n = order.abs_order_map.size();
+  const char* m = std::getenv("GRANITE_GAUGE_PRIOR");
+  if (m && std::string(m) == "none") return;
+  if (m && std::string(m) == "schur") {
+    // Marginalize the common translation out of the prior.
+    const Eigen::MatrixXd Nh = N / std::sqrt(n);
+    const Eigen::MatrixXd HNh = H * Nh;
+    const Eigen::Matrix3d A = Nh.transpose() * HNh;
+    Eigen::LDLT<Eigen::Matrix3d> ldlt(A);
+    if (ldlt.info() == Eigen::Success && ldlt.isPositive() && A.diagonal().minCoeff() > 1e-12) {
+      const Eigen::Vector3d bN = Nh.transpose() * b;
+      b -= HNh * ldlt.solve(bN);
+      H -= HNh * ldlt.solve(HNh.transpose());
+      H = (0.5 * (H + H.transpose())).eval();
+      return;
+    }
+  }
+  // P H P = H - N (N^T H)/n - (H N) N^T/n + N (N^T H N) N^T / n^2
+  const Eigen::MatrixXd HN = H * N;
+  const Eigen::Matrix3d NHN = N.transpose() * HN;
+  H -= (HN * N.transpose() + N * HN.transpose()) / n;
+  H += N * NHN * N.transpose() / (n * n);
+  H = (0.5 * (H + H.transpose())).eval();
+  b -= N * (N.transpose() * b) / n;
+}
+
+void KeypointVioEstimator::anchorGauge(const AbsOrderMap& order, Eigen::MatrixXd& H) const {
+  const char* w_env = std::getenv("GRANITE_GAUGE_W");
+  const double w = w_env ? std::atof(w_env) : 100.0;
+  const double n = order.abs_order_map.size();
+  for (const auto& i : order.abs_order_map)
+    for (const auto& j : order.abs_order_map)
+      H.block<3, 3>(i.second.first, j.second.first).diagonal().array() += w / n;
+}
+}  // namespace granite
