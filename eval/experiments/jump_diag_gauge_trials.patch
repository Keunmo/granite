+namespace granite {
+bool KeypointVioEstimator::gateGaugeStep(const AbsOrderMap& aom, Eigen::VectorXd& inc) {
+  // The increment is applied as -inc; a common translation of all poses and
+  // states changes no visual or inertial residual.
+  Eigen::Vector3d common = Eigen::Vector3d::Zero();
+  const char* mode = std::getenv("GRANITE_GAUGE_MODE");
+  if (mode && std::string(mode) == "mean") {
+    for (const auto& kv : aom.abs_order_map) common += inc.segment<3>(kv.second.first);
+    common /= double(aom.abs_order_map.size());
+  } else {
+    int64_t anchor = -1;
+    size_t offset = 0;
+    for (const auto& kv : aom.abs_order_map)
+      if (anchor < 0 || size_t(kv.second.first) < offset) { anchor = kv.first; offset = kv.second.first; }
+    common = inc.segment<3>(offset);
+  }
+  if (common.norm() <= config.vio_gauge_gate_m) return false;
+  for (const auto& kv : aom.abs_order_map) inc.segment<3>(kv.second.first) -= common;
+  ++gauge_gate_count;
+  if (std::getenv("GRANITE_GAUGE_LOG"))
+    std::cout << "VIO_GAUGE_GATE t_ns=" << this_state_t_ns << " common_m=" << common.norm() << std::endl;
+  return true;
+}
